---
layout: null
permalink: /mindmap.json
---
{
  "center": {{ site.mindmap.center | default: site.title | jsonify }},
  "fields": {{ site.data.fields | jsonify }},
  "papers": [
  {%- for p in site.papers %}
    {
      "title": {{ p.title | jsonify }},
      "short": {{ p.short | jsonify }},
      "field": {{ p.field | jsonify }},
      "topic": {{ p.topic | jsonify }},
      "approach": {{ p.approach | jsonify }},
      "venue": {{ p.venue | jsonify }},
      "year": {{ p.year | jsonify }},
      "url": {{ p.url | relative_url | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  ]
}
